<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
         The ACCESS_COARSE/FINE_LOCATION permissions are not required to use
         Google Maps Android API v2, but you must specify either coarse or fine
         location permissions for the 'MyLocation' functionality.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Obrigatória a partir do Android 13 (API 33) para mostrar notificações
         — antes disso não existia, o pedido é ignorado em versões anteriores.
         Documentação oficial: https://developer.android.com/develop/ui/views/notifications/notification-permission -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Necessária para ler QR codes de check-in (zxing-android-embedded).
         A biblioteca trata do pedido em tempo de execução sozinha através do
         seu próprio ecrã de câmara (CaptureActivity), mas a permissão tem de
         estar declarada aqui de qualquer forma. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <!-- Login por biometria (opt-in, ver Utils.kt/ProfileActivity/
         VerificarLoginActivity). Normal permission, concedida
         automaticamente pelo sistema — não precisa de pedido em runtime. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- REMOVIDO: WRITE_EXTERNAL_STORAGE, READ_EXTERNAL_STORAGE e STORAGE não são
         usadas por nenhum código ativo (só pela funcionalidade de foto de perfil,
         que está desativada/comentada em ProfileActivity.kt). Pedir permissões que a
         app não usa é má prática — gera desconfiança e atrito na revisão da Play
         Store. "android.permission.STORAGE" nem sequer é uma permissão válida do
         Android (não existe essa constante). Se a funcionalidade de foto for
         terminada no futuro, adicionar antes READ_MEDIA_IMAGES (Android 13+, API
         33+), que é a permissão correta e mais restrita para esse caso — ver
         https://developer.android.com/about/versions/13/behavior-changes-13#granular-media-permissions -->

    <application
        android:name=".VariaveisGlobais"
        android:allowBackup="false"
        android:icon="@mipmap/hunt_icon_round"
        android:label="@string/app_name"
        android:logo="@mipmap/hunt_icon_round"
        android:roundIcon="@mipmap/hunt_icon_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".ListaSociosOrgActivity" />
        <!-- CORRIGIDO: esta activity tinha exported="true" sem intent-filter, o que
             permitia a QUALQUER outra app no telemóvel abri-la diretamente (mostra
             nomes e números de cartão de caçador de sócios), sem passar pelo login.
             Só a activity de arranque (VerificarLoginActivity, com o intent-filter
             MAIN/LAUNCHER) deve ter exported="true". -->
        <activity android:name=".AdmissaoActivity" />
        <activity android:name=".CriarOrgEventoActivity" />
        <activity android:name=".OrgActivity" /> <!-- <activity android:name=".VerGrupoOrgActivity" /> -->
        <activity android:name=".FiltrosActivity" />
        <activity android:name=".ListaGruposActivity" />
        <activity android:name=".PreferenciasActivity" /> <!-- The meta-data tag is required if you support API level 15 and lower -->
        <!--
             The API key for Google Maps-based APIs is defined as a string resource.
             (See the file "res/values/google_maps_api.xml").
             Note that the API key is linked to the encryption key used to sign the APK.
             You need a different API key for each encryption key, including the release key that is used to
             sign the APK for publishing.
             You can define the keys for the debug and release targets in src/debug/ and src/release/.
        -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/google_maps_key" />

        <activity
            android:name=".MapsActivity"
            android:label="@string/title_activity_maps" />
        <activity
            android:name=".AdesaoActivity"
            android:screenOrientation="fullSensor" />
        <activity
            android:name=".DetalhesEventoActivity"
            android:exported="true"
            android:screenOrientation="fullSensor">
            <!-- Link de partilha de evento (Tipo 2 — esquema próprio da app,
                 sem verificação de domínio: só funciona em telemóveis que já
                 têm a app instalada. Ver docs/PLANO_DESENVOLVIMENTO.md secção
                 10 para o caminho de evolução para um verdadeiro App Link
                 https:// (Tipo 1), que também funciona para quem ainda não
                 tem a app instalada — precisa de um domínio próprio, por
                 isso fica documentado para mais tarde, não feito agora. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="apphuntig" android:host="evento" />
            </intent-filter>
        </activity>
        <activity
            android:name=".VerGrupoActivity"
            android:screenOrientation="fullSensor" /> <!-- <activity -->
        <!-- android:name=".CriarGrupoActivity" -->
        <!-- android:screenOrientation="portrait" /> -->
        <activity
            android:name=".EventoActivity"
            android:screenOrientation="fullSensor" />
        <activity
            android:name=".GrupoActivity"
            android:screenOrientation="fullSensor" />
        <activity android:name=".VerificarLoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ProfileActivity"
            android:screenOrientation="fullSensor"/>
        <activity
            android:name=".HomeActivity"
            android:screenOrientation="fullSensor" />
        <activity
            android:name=".RegistoUserActivity"
            android:screenOrientation="fullSensor"
            android:windowSoftInputMode="adjustPan" />
        <activity
            android:name=".LoginActivity"
            android:screenOrientation="fullSensor" />
        <activity
            android:name=".SuperAdminActivity"
            android:screenOrientation="fullSensor" />
        <activity
            android:name=".SuperAdminUsersActivity"
            android:screenOrientation="fullSensor" />
        <activity
            android:name=".SuperAdminGruposActivity"
            android:screenOrientation="fullSensor" />
        <activity
            android:name=".EventosProximosActivity"
            android:screenOrientation="fullSensor" />
        <activity
            android:name=".OnboardingActivity"
            android:screenOrientation="fullSensor" />
        <activity
            android:name=".MeusEventosActivity"
            android:screenOrientation="fullSensor" />
        <activity
            android:name=".DefinicoesActivity"
            android:screenOrientation="fullSensor" />
        <activity
            android:name=".AjudaActivity"
            android:screenOrientation="fullSensor" />
        <service
            android:name=".HuntigMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Recomendado pela documentação oficial ao usar
             AppCompatDelegate.setApplicationLocales() (ver Utils.kt) — permite
             que a escolha de idioma feita dentro da app sincronize com o
             seletor de idioma por app do próprio Android 13+ (Definições do
             sistema > Apps > HuntingEvent > Idioma).
             https://developer.android.com/guide/topics/resources/app-languages#appcompat-store -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

    </application>

</manifest>