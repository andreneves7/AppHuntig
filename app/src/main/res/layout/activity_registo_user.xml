<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".RegistoUserActivity">


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.484"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.009">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:dividerHeight="50px"
            android:orientation="vertical">

            <EditText
                android:id="@+id/addNome"
                android:layout_width="345dp"
                android:layout_height="54dp"
                android:ems="10"
                android:hint="Name"
                android:inputType="textPersonName" />

            <View
                android:id="@+id/divider"
                android:layout_width="327dp"
                android:layout_height="12dp"
                android:layout_marginStart="16dp"
                android:layout_marginLeft="16dp"
                android:color="#1FFFFFFF"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:id="@+id/addEmail"
                android:layout_width="348dp"
                android:layout_height="53dp"
                android:ems="10"
                android:hint="Email"
                android:inputType="textEmailAddress" />

            <EditText
                android:id="@+id/addPass"
                android:layout_width="346dp"
                android:layout_height="54dp"
                android:ems="10"
                android:hint="Password"
                android:inputType="textPassword" />

            <EditText
                android:id="@+id/addTele"
                android:layout_width="346dp"
                android:layout_height="58dp"
                android:ems="10"
                android:hint="Telefone"
                android:inputType="phone" />

            <EditText
                android:id="@+id/addCartaCaca"
                android:layout_width="match_parent"
                android:layout_height="51dp"
                android:layout_marginTop="16dp"
                android:ems="10"
                android:hint="Numero Carta Caçador"
                android:inputType="numberSigned"
                app:layout_constraintTop_toTopOf="parent" />

            <Button
                android:id="@+id/bRegistar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/botoes"
                android:text="@string/registar" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="31dp" />

        </LinearLayout>
    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>
