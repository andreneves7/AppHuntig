{
  "rules": {

    ".read": false,
    ".write": false,

    "Users": {

      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('Users').child(auth.uid).child('role').val() === 'superadmin')",
        ".write": "auth != null && (auth.uid === $uid || root.child('Users').child(auth.uid).child('role').val() === 'superadmin')",

        ".validate": "!newData.hasChild('morada') && !newData.hasChild('localidade') && !newData.hasChild('Codigo Postal') && !newData.hasChild('Licença Arma') && !newData.hasChild('Nome Seguradora') && !newData.hasChild('Numero Apolice') && !newData.hasChild('BI') && !newData.hasChild('Nif') && !newData.hasChild('Licenca Portugal') && !newData.hasChild('Licenca Espanha') && !newData.hasChild('Dni') && !newData.hasChild('Passaporte') && !newData.hasChild('Pais') && !newData.hasChild('nome Seguradora Extra') && !newData.hasChild('numero Apolice Extra') && !newData.hasChild('Numero Passaporte Europeu')",

        "role": {
          ".validate": "root.child('Users').child(auth.uid).child('role').val() === 'superadmin' || (!data.exists() && newData.val() === 'cacador')"
        },

        "Grupos": {
          "$numeroGrupo": {
            ".write": "auth != null && (auth.uid === $uid || root.child('Users').child(auth.uid).child('role').val() === 'superadmin' || root.child('Grupos').child($numeroGrupo).child('admin').val() === auth.uid)"
          }
        }
      }
    },

    "PerfisPublicos": {
      ".read": "auth != null",

      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('Users').child(auth.uid).child('role').val() === 'superadmin')",

        ".validate": "newData.hasChildren(['name', 'Carta Caçadore'])"
      }
    },

    "Grupos": {
      ".read": "auth != null",
      ".indexOn": ["admin"],

      "$grupoId": {
        ".write": "auth != null && (root.child('Grupos').child($grupoId).child('admin').val() === auth.uid || root.child('Users').child(auth.uid).child('role').val() === 'superadmin')",

        "admin": {
          ".validate": "!newData.exists() || newData.isString()"
        },

        "Pendentes": {
          "$uid": {
            ".write": "auth != null && ($uid === auth.uid || root.child('Grupos').child($grupoId).child('admin').val() === auth.uid || root.child('Users').child(auth.uid).child('role').val() === 'superadmin')"
          }
        }
      }
    },

    "EventosPublicos": {
      ".read": "auth != null",
      ".indexOn": ["dataFimTimestamp", "numeroGrupo"],

      "$eventoId": {
        ".write": "auth != null && (root.child('Users').child(auth.uid).child('role').val() === 'organizacao' || root.child('Users').child(auth.uid).child('role').val() === 'superadmin')",

        ".validate": "newData.hasChildren(['nome', 'Forma'])",

        "nome": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },

        "Forma": {
          ".validate": "newData.val() === 'publico'"
        },

        "Presenças": {
          ".write": "auth != null"
        },

        "ListaEspera": {
          ".write": "auth != null"
        }
      }
    },

    "EventosPrivados": {
      "$numeroGrupo": {
        ".read": "auth != null && root.child('Users').child(auth.uid).child('Grupos').child($numeroGrupo).exists()",
        ".indexOn": ["dataFimTimestamp"],

        "$eventoId": {
          ".write": "auth != null && (root.child('Grupos').child($numeroGrupo).child('admin').val() === auth.uid || root.child('Users').child(auth.uid).child('role').val() === 'superadmin')",

          ".validate": "newData.hasChildren(['nome', 'Forma'])",

          "nome": {
            ".validate": "newData.isString() && newData.val().length > 0"
          },

          "Forma": {
            ".validate": "newData.val() === 'privado'"
          },

          "Presenças": {
            ".write": "auth != null && root.child('Users').child(auth.uid).child('Grupos').child($numeroGrupo).exists()"
          },

          "ListaEspera": {
            ".write": "auth != null && root.child('Users').child(auth.uid).child('Grupos').child($numeroGrupo).exists()"
          }
        }
      }
    }

  }
}
